    "web": "node ./scripts/apply-ui-runtime-patches.mjs && expo start --web",
    "typecheck": "node ./scripts/apply-ui-runtime-patches.mjs && tsc --noEmit",
    "pwa:stamp": "node ./scripts/stamp-pwa-cache.mjs",
    "export:web": "node ./scripts/apply-ui-runtime-patches.mjs && pnpm pwa:stamp && expo export --platform web && node ./scripts/ensure-pages-fallback.mjs && node ./scripts/generate-seo-assets.mjs",
    "export:pages": "node ./scripts/apply-ui-runtime-patches.mjs && pnpm pwa:stamp && expo export --platform web && node ./scripts/ensure-pages-fallback.mjs && node ./scripts/generate-seo-assets.mjs",
    "serve:e2e": "node ./scripts/serve-dist.mjs",
    "test:e2e": "playwright test",
    "content:import": "node ./scripts/import-content.mjs",
    "content:import-latest": "node ./scripts/import-latest-catalog.mjs",
    "content:validate-latest": "node ./scripts/validate-latest-catalog.mjs",
    "content:import-complete": "node ./scripts/import-complete-markdown.mjs",
    "content:import-persona-markdown": "node ./scripts/import-persona-markdown.mjs",
    "content:restructure-personas": "node ./scripts/restructure-persona-catalog.mjs",
    "content:sync-learning": "node ./scripts/sync-learning-content.mjs",
    "content:audit-learning": "node ./scripts/audit-learning-content.mjs",
    "content:import-master336": "node ./scripts/import-master336-markdown.mjs",
    "content:write-master336-explanations": "node ./scripts/generate-master336-explanations.mjs",
    "content:validate-master336": "node ./scripts/validate-master336-catalog.mjs",
    "content:optimize-theory-links": "node ./scripts/optimize-master336-theory-links.mjs",
    "content:audit-theory-links": "node ./scripts/audit-master336-theory-links.mjs",
    "content:validate-theory-mapping": "node ./scripts/validate-master336-theory-mapping.mjs",
    "content:build-theory-mapping": "node ./scripts/build-master336-theory-mapping.mjs",
    "content:import-theory-mapping": "node ./scripts/import-master336-theory-mapping.mjs",
    "content:link-persona-theories": "node ./scripts/link-persona-catalog-theories.mjs",
    "content:add-researched-theories": "node ./scripts/add-researched-theories.mjs",
    "content:optimize-theory-cards": "node ./scripts/optimize-theory-card-quality.mjs",
    "content:audit-theory-quality": "node ./scripts/audit-theory-card-quality.mjs",
    "content:import-practical": "node ./scripts/import-practical-actions.mjs",
    "content:import-owner": "node ./scripts/import-owner-content.mjs",
    "content:audit": "node ./scripts/audit-theories.mjs",
    "content:audit-techniques": "node ./scripts/audit-techniques.mjs",
    "content:audit-search": "node ./scripts/audit-technique-search.mjs",
    "content:expand-tags": "node ./scripts/expand-technique-tags.mjs",
    "content:refine-techniques": "node ./scripts/refine-technique-explanations.mjs",
    "content:refine-theories": "node ./scripts/refine-theory-summaries.mjs",
    "content:urahidensho": "node ./scripts/build-urahidensho-content.mjs",
    "assets:generate": "node ./scripts/generate-assets.cjs",
    "store:assets": "node ./scripts/generate-store-assets.mjs"
  },
  "private": true
}
